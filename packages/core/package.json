{
  "name": "@virtual-finder/core",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ipc": {
      "types": "./dist/ipc/contracts.d.ts",
      "default": "./dist/ipc/contracts.js"
    }
  },
  "typesVersions": {
    "*": {
      "ipc": [
        "dist/ipc/contracts.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "benchmark": "tsx src/__benchmarks__/performance.benchmark.ts",
    "test": "node ../../scripts/run-tests.cjs",
    "test:watch": "node ../../scripts/run-tests.cjs --watch"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.3.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "openai": "^7.52.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
