{
  "name": "@virtual-finder/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-preload.cjs",
    "test": "node ../../scripts/run-tests.cjs --desktop",
    "dev": "npm run build && node ../../scripts/run-electron.cjs .",
    "start": "node ../../scripts/run-electron.cjs .",
    "package": "electron-builder",
    "clean": "rm -rf dist out"
  },
  "dependencies": {
    "@virtual-finder/core": "file:../../packages/core",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.virtualfinder.app",
    "productName": "Fily",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "icon": "assets/icons/Icon.icns"
    },
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/icons/**/*",
      "!node_modules/@virtual-finder/core/src",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui"
      }
    ]
  }
}
